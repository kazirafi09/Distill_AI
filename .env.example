# PostgreSQL
POSTGRES_USER=distill_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=distill_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442

# Authentication
JWT_SECRET_KEY=generate_your_own_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_SESSION_DAYS=7

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_NAME=job-openings
DISCORD_TIMEOUT_SECONDS=20

# Google Drive CV ingestion
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_CREDENTIALS_HOST_PATH=
GOOGLE_DRIVE_CV_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TIMEOUT_SECONDS=30

CV_STORAGE_PATH=
# CV parsing uses the existing Docker Ollama service; separate from GROQ_MODEL.
CV_PARSER_MODEL=qwen3:4b
# auto uses Gemini when GEMINI_API_KEY is set; ollama keeps all model calls local.
CV_MODEL_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_CV_MODEL=gemini-3.5-flash-lite
CV_GEMINI_CONTEXT_TOKENS=65536
CV_MCP_URL=http://127.0.0.1:8000/mcp/
CV_OCR_LANGUAGE=eng
CV_MODEL_TIMEOUT_SECONDS=300

# Gmail SMTP: app password, not the normal account password. STARTTLS required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# Email MCP: use http://email-mcp:8003/mcp/ for a client inside Docker.
EMAIL_MCP_URL=http://127.0.0.1:8003/mcp/
EMAIL_MCP_SECRET=

PUBLIC_APP_URL=http://localhost:5173
INTERVIEW_LINK_DAYS=7

# Deepgram prerecorded transcription (backend only).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT_SECONDS=180
