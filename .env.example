# PostgreSQL
POSTGRES_USER=distill_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=distill_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442

# Optional pgAdmin web login. Blank password uses POSTGRES_PASSWORD on first setup.
PGADMIN_DEFAULT_EMAIL=admin@distill.example.com
PGADMIN_DEFAULT_PASSWORD=

# Authentication
JWT_SECRET_KEY=generate_your_own_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_SESSION_DAYS=7

GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

DISCORD_WEBHOOK_URL=
DISCORD_CHANNEL_NAME=job-openings
DISCORD_TIMEOUT_SECONDS=20

# Google Drive CV ingestion
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DRIVE_CREDENTIALS_HOST_PATH=
GOOGLE_DRIVE_CV_ROOT_FOLDER_ID=
GOOGLE_DRIVE_TIMEOUT_SECONDS=30

CV_STORAGE_PATH=
# Local CV parsing uses the existing Docker Ollama service.
CV_PARSER_MODEL=qwen3:4b
# auto uses Gemini when GEMINI_API_KEY is set; ollama keeps all model calls local.
CV_MODEL_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_CV_MODEL=gemini-3.5-flash-lite
# Shared across chat, API, CV workers and assessment branches; hard cap 12 RPM.
GEMINI_REQUESTS_PER_MINUTE=12
GEMINI_MAX_RETRIES=3
CV_GEMINI_CONTEXT_TOKENS=65536
CV_MCP_URL=http://127.0.0.1:8000/mcp/
CV_OCR_LANGUAGE=eng
CV_MODEL_TIMEOUT_SECONDS=300

# F5 interview analysis uses the existing Gemini integration and API key.
# Explicit settings; no automatic provider fallback.
F5_MODEL_PROVIDER=gemini
F5_MODEL_NAME=gemini-3.5-flash-lite
F5_MODEL_CONTEXT_TOKENS=65536
F5_MODEL_OUTPUT_TOKENS=4096
F5_MODEL_TIMEOUT_SECONDS=300

# Separate consolidation settings; shares the existing Gemini project rate cap.
F6_MODEL_PROVIDER=gemini
F6_MODEL_NAME=gemini-3.5-flash-lite
F6_MODEL_CONTEXT_TOKENS=262144
F6_MODEL_OUTPUT_TOKENS=8192
F6_MODEL_TIMEOUT_SECONDS=300

# Gmail SMTP: app password, not the normal account password. STARTTLS required.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# Email MCP: use http://email-mcp:8003/mcp/ for a client inside Docker.
EMAIL_MCP_URL=http://127.0.0.1:8003/mcp/
EMAIL_MCP_SECRET=

PUBLIC_APP_URL=http://localhost:5173
INTERVIEW_LINK_DAYS=7

# Optional hostname when accessing the frontend through a tunnel.
VITE_ALLOWED_HOST=

# Same-PC LiveKit development server (compose service runs with --dev).
# Use http://127.0.0.1:7880 when running the backend outside Docker.
# For LiveKit Cloud, replace both URLs and credentials in your private .env.
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Deepgram live transcription (backend only).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT_SECONDS=180
DEEPGRAM_ENDPOINTING_MS=400
# JSON list; hints guide recognition, never replace the recognized evidence.
DEEPGRAM_KEYTERMS=["FastAPI","PostgreSQL","API endpoints"]
# F7: install models with python -m app.scripts.setup_face_models.
# Similarity scores work without a threshold; automatic verdicts require one.
# Set after evaluating matching errors on representative consenting test images.
# OpenCV's LFW example uses 0.363; that is a benchmark value, not local calibration.
# FACE_MATCH_THRESHOLD=0.363
IDENTITY_RETENTION_DAYS=30
